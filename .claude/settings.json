{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/repos/runcove/scripts/beads-prime-hook.sh\" SessionStart 2>/dev/null || true",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/session-start-context.sh\" --event SessionStart 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "BEADS_ACTOR": "artifacts-maintainer"
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd -C \"$HOME/repos/homelab\" prime --hook-json 2>/dev/null || true",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/session-start-context.sh\" --event SessionStart 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/session-start-context.sh\" --event PostCompact 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
